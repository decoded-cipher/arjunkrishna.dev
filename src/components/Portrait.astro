---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/assets/portrait-1.{jpg,jpeg,png,webp}', {
  eager: true,
});
const portrait = Object.values(images)[0]?.default;
---

<figure class="portrait">
  {
    portrait ? (
      <Picture
        class="u-photo"
        src={portrait}
        alt="Arjun Krishna, in black and white"
        widths={[300, 600, 900, 1200]}
        sizes="(max-width: 900px) calc(100vw - 2.75rem), 300px"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="placeholder" role="img" aria-label="Portrait coming soon" />
    )
  }
</figure>
