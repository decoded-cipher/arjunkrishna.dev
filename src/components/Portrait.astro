---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/assets/portrait-2.{jpg,jpeg,png,webp}', {
  eager: true,
});
const portrait = Object.values(images)[0]?.default;
---

<figure class="portrait">
  {
    portrait ? (
      <Picture
        class="u-photo"
        src={portrait}
        alt="Arjun Krishna, in black and white"
        width={900}
        widths={[300, 600, 900]}
        sizes="(max-width: 900px) 10rem, (max-width: 1100px) 280px, 300px"
        formats={['avif']}
        fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="placeholder" role="img" aria-label="Portrait coming soon" />
    )
  }
</figure>
