---
import { dayMonth, shortDate } from '../lib/date';
import { external } from '../lib/ref';

export interface Post {
  title: string;
  url: string;
  date: Date;
  excerpt: string;
  source?: string;
}

interface Props {
  posts: Post[];
  withYear?: boolean;
}

const { posts, withYear = true } = Astro.props;
---

<ol class="rows posts">
  {
    posts.map((post) => (
      <li class="row h-entry">
        <time class="when dt-published" datetime={post.date.toISOString()}>
          {withYear ? shortDate(post.date) : dayMonth(post.date)}
        </time>
        <span class="what">
          <a class="u-url p-name" {...external(post.url)}>{post.title}</a>
          {post.source && <span class="source"> · {post.source}</span>}
        </span>
        <span class="aside p-summary">{post.excerpt}</span>
      </li>
    ))
  }
</ol>
