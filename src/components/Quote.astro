---
import { withRef } from '../lib/ref';

interface Props {
  source: string;
  href: string;
  year: number;
}

const { source, href, year } = Astro.props;
---

<figure class="quote">
  <blockquote><slot /></blockquote>
  <figcaption>— from <a href={withRef(href)}>{source}</a>, {year}</figcaption>
</figure>
