---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allPosts } from '../../lib/posts';
import { yearOf } from '../../lib/date';
import { external } from '../../lib/ref';
import { absolute, path } from '../../lib/url';
import { author, breadcrumbs, itemList, page } from '../../lib/schema';
import { site } from '../../site';

const posts = await allPosts();
const years = [...new Set(posts.map((post) => yearOf(post.date)))];
const publisher = (source?: string) =>
  source === 'Medium'
    ? { '@type': 'Organization', name: 'Medium', url: 'https://medium.com' }
    : { '@type': 'Organization', name: 'Inovus Labs', url: 'https://inovuslabs.org' };
const description = 'Essays and notes by Arjun Krishna, mostly about software, learning and the internet.';

const schema = [
  page('CollectionPage', '/writing/', `Writing — ${site.name}`, description, {
    breadcrumb: { '@id': absolute('/writing/#breadcrumbs') },
    mainEntity: itemList(
      posts.map((post) => ({
        '@type': 'BlogPosting',
        '@id': post.url,
        url: post.url,
        headline: post.title,
        description: post.excerpt,
        datePublished: post.date.toISOString(),
        inLanguage: 'en',
        author,
        publisher: publisher(post.source),
      })),
    ),
  }),
  breadcrumbs('/writing/', 'Writing'),
];
---

<Base title="Writing" description={description} og="writing" schema={schema}>
  <section class="grid">
    <div class="intro">
      <h1>Writing</h1>
      <p>
        Essays and notes, mostly about software, learning, and the internet. Most are published on{' '}
        <a {...external('https://blog.inovuslabs.org/author/arjun/')}>Inovus Blogs</a>; the older ones are on Medium. There is an{' '}
        <a href={path('/rss.xml')}>RSS feed</a>.
      </p>
    </div>
    {
      years.map((year) => (
        <>
          <h2 class="year">{year}</h2>
          <PostList posts={posts.filter((post) => yearOf(post.date) === year)} withYear={false} />
        </>
      ))
    }
  </section>
</Base>
