---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { monthYear } from '../lib/date';
import { site } from '../site';
import { external } from '../lib/ref';
import { absolute } from '../lib/url';
import { author, breadcrumbs, itemList, page } from '../lib/schema';
import { lastmod } from '../lib/lastmod';
import { homeOf, restOf } from '../lib/projects';

const entries = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const contributions = (await getCollection('contributions')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const small = (await getCollection('small')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const updated = (await lastmod())['/projects'];

const description =
  'Personal projects by Arjun Krishna, built outside his day job — Nodrix, an IoT platform for Cloudflare, Reelity, BitNerve, NetMon and more.';

const schema = [
  page('CollectionPage', '/projects', `Personal projects — ${site.name}`, description, {
    dateModified: updated.toISOString(),
    breadcrumb: { '@id': absolute('/projects#breadcrumbs') },
    mainEntity: itemList(
      entries.map(({ id, data, body = '' }) => ({
        '@type': data.links.source ? 'SoftwareSourceCode' : 'CreativeWork',
        '@id': absolute(`/projects#${id}`),
        name: data.name,
        description: body.trim(),
        url: data.links.site ?? absolute(`/projects#${id}`),
        ...(data.links.source && { codeRepository: data.links.source }),
        ...(data.links.writeup && { subjectOf: { '@type': 'BlogPosting', url: data.links.writeup } }),
        ...(data.parent && { isPartOf: { '@id': absolute(`/projects#${data.parent}`) } }),
        keywords: data.stack,
        author,
      })),
    ),
  }),
  breadcrumbs('/projects', 'Projects'),
];
---

<Base title="Personal projects" description={description} og="projects" schema={schema} updated={updated}>
  <section class="grid wide">
    <div class="intro">
      <h1>Personal projects</h1>
      <p>
        What I build when the workday is done. Most began as a question I couldn’t let go of, and a few turned into
        things other people now use.
      </p>
    </div>

    <ol class="rows things works">
      {
        entries.map((entry) => (
          <li class="row" id={entry.id}>
            <span class="when">{monthYear(entry.data.date)}</span>
            <span class="what">
              <a {...external(homeOf(entry))}>{entry.data.name}</a>
              <span>{(entry.body ?? '').trim()}</span>
            </span>
            <span class="aside">
              <span>{entry.data.stack}</span>
              {restOf(entry).length > 0 && (
                <span class="links">
                  {restOf(entry).map((link) => (
                    <a {...external(link.href)}>{link.label}</a>
                  ))}
                </span>
              )}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="fleuron" aria-hidden="true">* * *</div>

    <h2 class="list-title">Tinkering</h2>
    <ol class="rows things">
      {
        small.map(({ data }) => (
          <li class="row">
            <span class="when">{monthYear(data.date)}</span>
            <span class="what">
              <a {...external(data.url)}>{data.name}</a>
              <span>{sentence(data.line)}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <h2 class="list-title">Contributions</h2>
    <ol class="rows things">
      {
        contributions.map(({ data }) => (
          <li class="row">
            <span class="when">{monthYear(data.date)}</span>
            <span class="what">
              <a {...external(data.url)}>{data.repo}</a>
              <span>{sentence(data.line)}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
