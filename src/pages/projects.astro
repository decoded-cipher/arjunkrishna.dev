---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { monthYear } from '../lib/date';
import { site } from '../site';
import { external } from '../lib/ref';
import { absolute } from '../lib/url';
import { author, breadcrumbs, itemList, page } from '../lib/schema';

const statusLabel = { active: 'Active', complete: 'Complete', maintained: 'Maintained', archived: 'Archived' };

const entries = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = await Promise.all(entries.map(async (entry) => ({ entry, ...(await render(entry)) })));
const small = (await getCollection('small')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const linkedin = site.profiles.find((p) => p.name === 'LinkedIn')!.url;

const linksOf = (links: { site?: string; source?: string; writeup?: string }) =>
  [
    links.site && { label: new URL(links.site).hostname, href: links.site },
    links.source && { label: 'Source', href: links.source },
    links.writeup && { label: 'Write-up', href: links.writeup },
  ].filter(Boolean) as { label: string; href: string }[];

const description =
  'Personal projects by Arjun Krishna, built outside his day job — Nodrix, an IoT platform for Cloudflare, Reelity, BitNerve, NetMon and more.';

const schema = [
  page('CollectionPage', '/projects/', `Personal projects — ${site.name}`, description, {
    breadcrumb: { '@id': absolute('/projects/#breadcrumbs') },
    mainEntity: itemList(
      entries.map(({ id, data, body = '' }) => ({
        '@type': data.links.source ? 'SoftwareSourceCode' : 'CreativeWork',
        '@id': absolute(`/projects/#${id}`),
        name: data.name,
        description: body.trim(),
        url: data.links.site ?? absolute(`/projects/#${id}`),
        ...(data.links.source && { codeRepository: data.links.source }),
        ...(data.links.writeup && { subjectOf: { '@type': 'BlogPosting', url: data.links.writeup } }),
        keywords: data.stack,
        creativeWorkStatus: statusLabel[data.status],
        author,
      })),
    ),
  }),
  breadcrumbs('/projects/', 'Projects'),
];
---

<Base title="Personal projects" description={description} og="projects" schema={schema}>
  <section class="grid">
    <div class="intro">
      <h1>Personal projects</h1>
      <p>
        Things I have built outside my day job. Most were made to understand how something works; a few are
        used by other people. For my employment history, see <a {...external(linkedin)}>LinkedIn</a>.
      </p>
    </div>

    <h2 class="section-title">Projects</h2>
    <ol class="rows">
      {
        projects.map(({ entry, Content }) => (
          <li class="row project" id={entry.id}>
            <div class="when">
              <span>{entry.data.years}</span>
              <span class="status">{statusLabel[entry.data.status]}</span>
            </div>
            <div class="what">
              <h3>{entry.data.name}</h3>
              <Content />
              <p class="source">{entry.data.stack}</p>
              <p class="links">
                {linksOf(entry.data.links).map((link) => (
                  <a {...external(link.href)}>{link.label}</a>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <h2 class="section-title">Smaller things</h2>
    <ol class="rows">
      {
        small.map(({ data }) => (
          <li class="row">
            <span class="when">{monthYear(data.date)}</span>
            <span class="what">
              <a {...external(data.url)}>{data.name}</a> — {data.line}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
