---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import Margin from '../components/Margin.astro';
import Portrait from '../components/Portrait.astro';
import PostList from '../components/PostList.astro';
import Bio from '../content/home.mdx';
import { site } from '../site';
import { allPosts } from '../lib/posts';
import { longDate } from '../lib/date';
import { lastUpdated } from '../lib/updated';
import { external } from '../lib/ref';
import { absolute, path } from '../lib/url';
import { author, page } from '../lib/schema';

const made = (await getCollection('projects', ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = (await allPosts()).slice(0, 7);
const updated = lastUpdated('src/content/home.mdx');
const schema = [
  page('ProfilePage', '/', site.title, site.description, {
    mainEntity: author,
    dateModified: updated.toISOString(),
    primaryImageOfPage: { '@type': 'ImageObject', url: absolute('/og/home.png') },
  }),
];
---

<Base type="profile" schema={schema}>
  <section class="grid bio h-card">
    <div class="masthead">
      <h1 class="p-name">Arjun{' '}<br />Krishna</h1>
      <p class="tagline p-note">{site.tagline}</p>
    </div>
    <Portrait />
    <Bio components={{ a: Link }} />
    <Margin>Some things I've made</Margin>
    <ul class="made">
      {
        made.map(({ id, data }) => (
          <li>
            <a {...external(data.links.site ?? data.links.source ?? data.links.writeup ?? path(`/work/#${id}`))}>{data.name}</a> —{' '}
            {data.homeLine}
          </li>
        ))
      }
      <li class="small">More on the <a href={path('/work/')}>work</a> page.</li>
    </ul>
    <p class="small">
      Last updated on <time datetime={updated.toISOString()}>{longDate(updated)}</time>. I can be reached at{' '}
      <a class="u-email" href={`mailto:${site.email}`}>{site.email}</a>, and I'm on{' '}
      {
        site.profiles.map((profile, i) => (
          <>
            {i > 0 && (i === site.profiles.length - 1 ? ' and ' : ', ')}
            <a class="u-url" rel="me" {...external(profile.url, { ref: false })}>{profile.name}</a>
          </>
        ))
      }.
    </p>
  </section>

  <div class="fleuron" aria-hidden="true">* * *</div>

  <section class="grid" aria-labelledby="writing">
    <h2 class="section-title" id="writing">Writing</h2>
    <PostList posts={posts} />
    <p class="small"><a href={path('/writing/')}>All writing, since 2019</a></p>
  </section>
</Base>
