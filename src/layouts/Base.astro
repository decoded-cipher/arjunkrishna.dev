---
import { Font } from 'astro:assets';
import { site } from '../site';
import { absolute, path } from '../lib/url';
import { base, type Thing } from '../lib/schema';
import { external } from '../lib/ref';
import logo from '../../assets/logo.svg?raw';
import { longDate } from '../lib/date';
import { icons } from '../lib/icons';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  og?: 'home' | 'projects' | 'blog' | 'releases' | 'colophon';
  type?: 'website' | 'profile';
  noindex?: boolean;
  updated?: Date;
  schema?: Thing[];
}

const {
  title,
  description = site.description,
  og = 'home',
  type = 'website',
  noindex = false,
  updated,
  schema = [],
} = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const current = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(current, Astro.site);
const active = (href: string) =>
  current === path(href) ? 'page' : href !== '/' && current.startsWith(`${path(href)}/`) ? 'true' : undefined;
const image = absolute(`/og/${og}.jpg`);
const imageAlt = title ? `${title}, by ${site.name}` : `${site.name}: ${site.tagline}`;
const elsewhere = [
  { name: 'Email', href: `mailto:${site.email}` },
  ...site.profiles.filter((profile) => icons[profile.name]).map((profile) => ({ name: profile.name, ...external(profile.url, { ref: false }) })),
  { name: 'RSS', href: path('/rss.xml') },
];
const graph = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...(await base()), ...schema] }).replace(
  /</g,
  '\\u003c',
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={site.name} href={path('/rss.xml')} />
    <link rel="sitemap" type="application/xml" href={path('/sitemap.xml')} />
    <link rel="icon" href={path('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={path('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={path('/apple-touch-icon.png')} />
    <link rel="manifest" href={path('/manifest.webmanifest')} />
    <meta name="theme-color" content="#f3f2ee" />
    {site.profiles.map((profile) => <link rel="me" href={profile.url} />)}
    <link rel="me" href={`mailto:${site.email}`} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {
      type === 'profile' && (
        <>
          <meta property="profile:first_name" content="Arjun" />
          <meta property="profile:last_name" content="Krishna" />
          <meta property="profile:username" content={site.handle} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.x} />
    <meta name="twitter:creator" content={site.x} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline type="application/ld+json" set:html={graph} />
    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header class:list={['site-header', { home: current === path('/') }]}>
        <a class="logo" href={path('/')} aria-label={site.name} set:html={logo} />
        <nav aria-label="Main">
          {
            site.nav.map((item) => (
              <a href={path(item.href)} aria-current={active(item.href)}>
                {item.name}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <p class="copyright">{site.name} <span class="mark">©</span> 2018–{new Date().getFullYear()}</p>
        {
          updated && (
            <p class="updated">
              <a href={path('/colophon')}>
                Last updated <time datetime={updated.toISOString()}>{longDate(updated)}</time>
              </a>
            </p>
          )
        }
        <nav aria-label="Elsewhere">
          {
            elsewhere.map(({ name, ...link }) => (
              <a {...link} aria-label={name} title={name}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[name]} />
              </a>
            ))
          }
        </nav>
      </footer>
    </div>
  </body>
</html>
